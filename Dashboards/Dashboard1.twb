      <column caption='PositionChange' datatype='string' name='[Calculation_1631147498669432832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT([qualifyingposition]) &gt; INT([finalposition]) THEN &quot;Improved&quot;&#13;&#10;ELSEIF INT([qualifyingposition]) &lt; INT([finalposition]) THEN &quot;Dropped&quot;&#13;&#10;ELSE &quot;Same&quot;&#13;&#10;END' />
      </column>
      <column caption='Fastest Lap(Secs)' datatype='real' name='[Calculation_1631147498677563394]' role='measure' type='quantitative'>
